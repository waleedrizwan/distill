{
  "manifest_version": 3,
  "name": "Distill",
  "version": "0.1.0",
  "description": "Right-click highlighted text and replace it with its most important sentences.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Distill: highlight text, right-click, Distill. On a PDF, click to open it in the Distill reader."
  },
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
